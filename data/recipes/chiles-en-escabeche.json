 "es": {
  "name": "Chiles en escabeche",
  "blurb": "Jalapeños y zanahorias en vinagre con hierbas. Están en la mesa de toda taquería mexicana.",
  "ing": [
   {
    "n": "chiles jalapeños",
    "note": "en rodajas"
   },
