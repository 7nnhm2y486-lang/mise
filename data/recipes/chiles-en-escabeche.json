   },
   {
    "n": "azúcar"
   }
  ],
  "steps": [
   "Sofríe el ajo, la cebolla y la zanahoria en el aceite 4 minutos.",
   "Añade los chiles y cocina 3 minutos.",
   "Añade el vinagre, el agua, las hierbas, la sal y el azúcar y hierve 5 minutos.",
   "Pasa a frascos limpios y deja enfriar. Refrigera 24 horas antes de comer."
  ],
  "tips": [
   "Se conservan 1 mes en la nevera.",
   "No los cuezas de más: deben seguir firmes."
  ],
