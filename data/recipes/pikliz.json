 "es": {
  "name": "Pikliz",
  "blurb": "Encurtido picante de repollo, zanahoria y chile scotch bonnet en vinagre. Acompaña el griot y todo lo frito en Haití.",
  "ing": [
   {
    "n": "repollo",
    "note": "en tiras finas"
   },
