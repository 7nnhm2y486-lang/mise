 "es": {
  "name": "Salpicão de frango",
  "blurb": "Ensalada fría de pollo con zanahoria, maíz, manzana y mayonesa. La ensalada de las fiestas de fin de año en Brasil.",
  "ing": [
   {
    "n": "pechuga de pollo cocida",
    "note": "desmenuzada"
   },
   {
    "n": "zanahorias",
    "note": "ralladas"
   },
   {
    "n": "granos de maíz cocidos"
   },
   {
    "n": "arvejas cocidas"
   },
   {
    "n": "manzana verde",
    "note": "en cubos"
   },
   {
    "n": "pasas"
   },
   {
    "n": "mayonesa"
   },
   {
    "n": "perejil",
    "note": "picado"
   },
   {
    "n": "sal"
   }
  ],
  "steps": [
   "Mezcla el pollo, la zanahoria, el maíz, las arvejas, la manzana y las pasas.",
   "Añade la mayonesa y la sal y mezcla.",
   "Refrigera 1 hora.",
   "Termina con el perejil."
  ],
  "tips": [
   "Revisa la etiqueta de la mayonesa: puede llevar mostaza o soja.",
   "Se conserva 1 día en la nevera."
  ],
  "video": "salpicão de frango"
 },
 "en": {
  "name": "Salpicão (Brazilian Chicken Salad)",
  "blurb": "A cold chicken salad with carrot, corn, apple and mayonnaise. The year-end party salad in Brazil.",
  "ing": [
