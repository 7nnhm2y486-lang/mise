    "note": "en dados pequeños"
   },
   {
    "n": "jugo de naranja"
   },
   {
    "n": "jugo de patilla licuada"
   },
   {
    "n": "azúcar"
   },
   {
    "n": "limones",
    "note": "exprimidos"
   },
   {
    "n": "hielo"
   }
  ],
  "steps": [
   "Pica todas las frutas en dados pequeños.",
   "Mezcla el jugo de naranja, el jugo de patilla, el limón y el azúcar hasta que se disuelva.",
   "Añade las frutas y refrigera 1 hora.",
   "Sirve con el hielo, con cuchara para las frutas."
  ],
  "tips": [
   "Pica el cambur al final para que no se oscurezca.",
   "Se toma el mismo día."
  ],
